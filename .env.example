# MySQL CryptoInsight
MYSQL_DATABASE=crypto_db
MYSQL_USER=crypto_user
MYSQL_PASSWORD=CryptoDemo2026_local
MYSQL_ROOT_PASSWORD=CryptoRoot2026_local
CRYPTO_DB_HOST=mysql
CRYPTO_DB_PORT=3306

# CoinGecko Demo API: configure your own key before starting ingestion.
COINGECKO_API_KEY=coloca_aqui_tu_clave
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
DEFAULT_COINS=bitcoin,ethereum,solana
DEFAULT_CURRENCY=usd

# Internal service communication (both values must match).
CRYPTO_API_URL=http://crypto-api:8000
NEST_API_URL=http://nest-api:3000
INTERNAL_API_KEY=cambia_esta_clave_interna
CRYPTO_INTERNAL_API_KEY=cambia_esta_clave_interna

# PostgreSQL and NestJS
TESLO_DB_NAME=teslo
TESLO_DB_USERNAME=teslo_user
TESLO_DB_PASSWORD=TesloDemo2026_local
TESLO_DB_HOST=postgres
TESLO_PORT=3000
TESLO_HOST_API=http://localhost:3000/api
JWT_SECRET=reemplaza_con_un_secreto_seguro
ENABLE_DB_SYNCHRONIZE=false
ENABLE_SEED_ENDPOINT=false
NODE_ENV=development
